# Copie para .env.local (que é gitignored) e preencha com os valores do seu projeto.
# Painel: supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-REF.supabase.co
# anon public key (JWT com role "anon") — usada no cliente; RLS protege os dados
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
# service_role (JWT com role "service_role") — NUNCA colocar no bundle do cliente;
# usada apenas em scripts/migrations server-side
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-aqui
